{
  "name": "react-native-silicon",
  "version": "0.0.1",
  "author": "Aleph-null Ltd <contact@aleph-null.co.uk> (https://github.com/Aleph-null-Ltd)",
  "license": "MIT",
  "homepage": "https://github.com/Aleph-null-Ltd/react-native-silicon",
  "description": "Hardware-backed cryptography for React Native and Expo (WIP)",
  "main": "./build/cjs/index.js",
  "module": "./build/esm/index.js",
  "types": "./build/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/esm/index.js",
      "require": "./build/cjs/index.js",
      "types": "./build/index.d.ts"
    }
  },
  "packageManager": "pnpm@11.3.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aleph-null-Ltd/react-native-silicon"
  },
  "bugs": {
    "url": "https://github.com/Aleph-null-Ltd/react-native-silicon/issues"
  },
  "scripts": {
    "clean": "rimraf build plugin/build && expo-module clean",
    "build:esm": "tsc -p ./tsconfig.esm.json",
    "build:cjs": "tsc -p ./tsconfig.cjs.json",
    "build:types": "tsc -p ./tsconfig.base.json --emitDeclarationOnly --outDir ./build/types",
    "build:plugin": "tsc --build plugin/tsconfig.json",
    "build": "pnpm run clean && pnpm run build:esm && pnpm run build:cjs && pnpm run build:types && pnpm run build:plugin",
    "lint": "expo-module lint",
    "test-old": "expo-module test",
    "test": "vitest run",
    "test:open-ui": "vitest --ui",
    "test:watch": "vitest -w",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts'",
    "test:unit:open-ui": "vitest run --ui --exclude '**/*.integration.test.ts'",
    "test:unit:watch": "vitest run -w --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run '**/*.integration.test.ts'",
    "test:integration:open-ui": "vitest run --ui '**/*.integration.test.ts'",
    "test:integration:watch": "vitest run -w '**/*.integration.test.ts'",
    "test:coverage": "vitest run --coverage",
    "test:clear-cache": "vitest --clearCache",
    "clear-test-cache-old": "expo-module jest --clearCache",
    "prepare-old": "expo-module prepare && npm run build:plugin",
    "prepare": "pnpm run build",
    "prepublishOnly": "npm run lint && npm run test && expo-module prepublishOnly",
    "expo-module": "expo-module",
    "open:ios:mac": "xed example/ios",
    "open:android:mac": "open -a \"Android Studio\" example/android",
    "watch": "tsc --watch"
  },
  "keywords": [
    "react-native",
    "expo",
    "react-native-silicon",
    "ReactNativeSilicon",
    "cryptography",
    "crypto",
    "hardware-backed",
    "hardware",
    "jwt",
    "dpop",
    "jose"
  ],
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@expo/config-plugins": "55.0.9",
    "@fast-check/vitest": "0.4.1",
    "@types/react": "19.2.10",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "4.1.10",
    "babel-preset-expo": "56.0.15",
    "eslint": "10.4.0",
    "expo": "55.0.30",
    "expo-module-scripts": "55.0.2",
    "fast-check": "4.8.0",
    "react-native": "0.83.10",
    "rimraf": "^6.1.3",
    "typescript": "5.9.2",
    "typescript-eslint": "8.59.3",
    "vite": "8.1.0",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "expo": ">=54.0.36",
    "react": "*",
    "react-native": "*"
  },
  "plugin": "app.plugin.js",
  "files": [
    "build",
    "src",
    "!**/__tests__",
    "!**/__mocks__",
    "!**/__test_utils__",
    "android",
    "!android/build",
    "ios",
    "!ios/Tests",
    "plugin",
    "app.plugin.js",
    "expo-module.config.json",
    "LICENSE",
    "README.md",
    "!*tsconfig*",
    "!*.ignore*"
  ]
}
